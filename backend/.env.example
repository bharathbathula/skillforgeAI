# SkillForge AI Environment Configuration Template

PROJECT_NAME="SkillForge AI"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkeythatisextremelysecureandrandom"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# =============================================
# DATABASE CONFIGURATION
# Set USE_SQLITE=true  -> Uses local SQLite database file (sqlite:///./skillforge.db)
# Set USE_SQLITE=false -> Uses PostgreSQL (fill in credentials below)
# =============================================
USE_SQLITE=true

# PostgreSQL Configuration (used when USE_SQLITE=false)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=skillforge_db

# Alternative direct connection string:
# DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/skillforge_db"

# =============================================
# MULTI-MODEL AI CONFIGURATION
# Provide any or all API keys for multi-model consensus ATS analysis.
# (Deterministic arithmetic fallback engine ensures 100% functionality even without keys)
# =============================================
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Vector storage & file upload paths
CHROMA_PERSIST_DIRECTORY="./chroma_db"
UPLOAD_DIRECTORY="./uploads"
